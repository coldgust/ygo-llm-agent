# 复制为 .env 后按需修改：cp .env.example .env
# 该文件被 docker compose 读取（compose.yaml 的 env_file）；本地裸跑由应用自行读 .env（DotEnv / spring.config.import）
# 默认值分级：环境相关项（地址/路径/凭据）无代码默认，缺失会启动失败并点名缺失的键——在本文件填写；
# 调优参数（等待预算/阈值/预算表等机器无关项）有代码默认，注释掉的键按需取消注释覆盖。

# ---------- YGOPro 连接（CLI 参数 --host 等可覆盖这里的值）----------
YGO_HOST=127.0.0.1
# YGO_PORT=7911                  # 代码默认 7911
# YGO_PLAYER_NAME=ygo-play-runner
# YGO_MOVE=second                # first / second

# ---------- 对局归档 ----------
DUEL_LOG_DIR=/tmp/ygo-duel-log  # 对局记录 JSONL 目录（文件名自动带时间戳）
TRACE_DIR=/tmp/ygo-trace        # 决策轨迹 JSONL 目录
BATTLE_REPORT=0                 # 实况战场播报输出文件路径；0/留空 = 关闭
DECK_STRATEGY=                  # 手写卡组打法思路（注入规划器/决策器上下文）
DECK_STRATEGY_FILE=             # 思路文件路径（优先于 DECK_STRATEGY 读文件内容）

# ---------- 对局运行调参（代码默认见 DuelTuning.defaults，按需取消注释）----------
# DUEL_RAW_FRAMES=false           # 原始协议帧写入对局记录（审计解码问题用，体积大）
# DUEL_CHOICE_TIMEOUT_MS=25000    # 看门狗：决策点因解码/映射异常没拿到应答时，超时由 SDK 提交保底应答的等待
# DUEL_START_WAIT_MS=180000       # 等待对手进房时长（实机调试常"先起客户端、再手动开对手"）
# COMBO_CONTEXT_LIMIT=10          # 己方主题注入规划器上下文的录入条数上限（1–30，创建时间倒序取最近）

# ---------- 决策器预算（代码默认见 RunnerConfig.defaults，按需取消注释覆盖）----------
# RUNNER_POLL_MS=25
# RUNNER_DEFAULT_BUDGET_MS=200    # 未单列预算的请求类型的兜底预算
# RUNNER_BUDGET_MAIN_PHASE_MS=12000
# RUNNER_BUDGET_BATTLE_PHASE_MS=10000
# RUNNER_BUDGET_CHAIN_MS=6000
# RUNNER_BUDGET_CARD_SELECT_MS=6000
# RUNNER_BUDGET_TRIBUTE_SELECT_MS=6000
# RUNNER_BUDGET_SUM_MS=6000
# RUNNER_BUDGET_UNSELECT_MS=5000
# RUNNER_BUDGET_SORT_MS=5000
# RUNNER_BUDGET_POSITION_MS=3000
# RUNNER_BUDGET_EFFECT_YES_NO_MS=4000
# RUNNER_BUDGET_YES_NO_MS=100     # 结构类请求仍由 REFLEX 直接答，毫秒级足够
# RUNNER_BUDGET_PLACE_MS=100      # 位置不为它单独发 LLM 请求（计划步/直答 一并给出 zone）
# RUNNER_BUDGET_DISFIELD_MS=100
# RUNNER_BUDGET_COUNTER_MS=150
# RUNNER_BUDGET_OPTION_MS=100
# RUNNER_BUDGET_DECLARE_RACE_MS=100
# RUNNER_BUDGET_DECLARE_ATTRIBUTE_MS=100
# RUNNER_BUDGET_DECLARE_CARD_MS=100
# RUNNER_BUDGET_DECLARE_NUMBER_MS=100

# ---------- PostgreSQL ----------
POSTGRES_USER=ygo
POSTGRES_PASSWORD=ygo
# 本地裸跑时使用；容器内由 compose 覆盖为 postgres:5432
POSTGRES_URL=jdbc:postgresql://localhost:5432/ygo

# ---------- Neo4j ----------
NEO4J_PASSWORD=change-me

# ---------- LLM（OpenAI 兼容网关）----------
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---------- Embedding ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=

# ---------- LightRAG ----------
LIGHTRAG_URL=http://localhost:9621   # 留空/删除该行 = 检索停用（规则/历史对局检索工具不注册）
LIGHTRAG_API_KEY=
# LIGHTRAG_TIMEOUT_MS=8000        # LightRAG HTTP 超时（代码默认 8000）

# ---------- v6 Planner–Executor（双 Agent：后台回合规划 + 前台快速决策）----------
PLAN_EXEC_ENABLED=              # 留空=有 LLM_API_KEY 即启用；false=强制关闭；true=显式开启（缺 key 报错）
CARD_RAG_PATH=data/card_rag/cards.jsonl   # 卡牌事实本地查表
LLM_REASONING_PLANNER=            # 规划器思考强度：off|low|medium|high；未配置=checkpoint 统一 low（推理档）、off=快档；抢答跟随 LLM_REASONING_DECISION
LLM_REASONING_DECISION=           # 决策器思考强度：off|low|medium|high；留空=默认 off（开了会吃决策超时）

# ---------- 决策等待/成本调优（代码默认见 PipelineSettings.defaults，按需取消注释）----------
# PLANNER_WAIT_DECISION_MS=4000    # 决策时一次最多等待规划器（紧急重规划回复）
# PLANNER_FIRST_WAIT_MS=7000       # 本回合首次决策器判断（④）前等计划的上限
# PLANNER_WAIT_TURN_MS=30000       # 一回合内"为等规划器"的累计上限
# PLANNER_MAX_CHECKPOINTS=6        # 每回合后台 checkpoint 次数上限
# PLANNER_SIMILARITY_THRESHOLD=0.80 # 执行器相似匹配阈值（防假相似）
# PLANNER_PATH_PLANNING=false      # 规划器是否产出可执行路径；false=顾问模式（只给场面分析/战术/combo）
# PLANNER_RUSH_ANSWER=true         # ④升级竞速里规划器抢答；false=升级只跑直答
# PLANNER_CALL_TIMEOUT_MS=45000    # 规划器后台 checkpoint 单次调用超时
# PLANNER_COOLDOWN_MS=60000        # 规划器连续失败后的降级冷却
# JUDGE_MAX_TOKENS=3000            # 直答输出上限
# JUDGE_TIMEOUT_MS=10000           # 决策器判断（④）硬超时

# ---------- 全链路日志（排查用；默认关）----------
YGO_VERBOSE_LOG=false             # true=把 LLM 请求/响应原文、工具调用、决策流水、轨迹事件打到日志
YGO_VERBOSE_MAX_CHARS=0            # 单条内容最长打印多少字；0=不截断（全量）
YGO_LOG_DIR=                      # 日志目录；留空=自动定位到仓库根 logs/

# ---------- 连招库（PG combo_record，唯一 combo 存储）----------
COMBO_SUMMARY_MODEL=              # 录入摘要模型；留空=用 LLM_MODEL

# ---------- 赛后复盘（写进 LightRAG，供 search_duels 检索）----------
DUEL_SUMMARY_ENABLED=true         # false=完全不写
DUEL_SUMMARY_MODE=llm             # llm（默认，模型写复盘）| template（不调模型，只记事实）
DUEL_SUMMARY_MODEL=               # 留空=用 LLM_MODEL
DUEL_SUMMARY_TIMEOUT_MS=60000     # 单次复盘超时（旁路任务，可以给得比决策宽）
DUEL_SUMMARY_MAX_TOKENS=2000
DUEL_NARRATIVE_MAX_CHARS=8000     # 逐回合记录的字符预算（喂给模型的素材上限）
