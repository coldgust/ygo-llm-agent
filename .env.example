# 复制为 .env 后按需修改：cp .env.example .env
# 该文件被 docker compose 读取（compose.yaml 的 env_file）；本地裸跑由应用自行读 .env（DotEnv / spring.config.import）

# ---------- PostgreSQL ----------
POSTGRES_USER=ygo
POSTGRES_PASSWORD=ygo
# 本地裸跑时使用；容器内由 compose 覆盖为 postgres:5432
POSTGRES_URL=jdbc:postgresql://localhost:5432/ygo

# ---------- Neo4j ----------
NEO4J_PASSWORD=change-me

# ---------- LLM（OpenAI 兼容网关）----------
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---------- Embedding ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=

# ---------- LightRAG ----------
LIGHTRAG_URL=http://localhost:9621
LIGHTRAG_API_KEY=

# ---------- v6 Planner–Executor（双 Agent：后台回合规划 + 前台快速决策）----------
PLAN_EXEC_ENABLED=            # 留空=有 LLM_API_KEY 即启用；false=强制关闭
PLANNER_WAIT_DECISION_MS=4000     # 决策时一次最多等待规划器（紧急重规划回复）
PLANNER_FIRST_WAIT_MS=7000        # 本回合首个 one-shot 前等计划的上限（规划 checkpoint 走推理档时经常等不到，首动作退回决策器判断）
PLANNER_WAIT_TURN_MS=30000        # 一回合内"为等规划器"的累计上限
PLANNER_MAX_CHECKPOINTS=6         # 每回合后台 checkpoint 次数上限
PLANNER_SIMILARITY_THRESHOLD=0.80 # 执行器相似匹配阈值（防假相似）
PLANNER_PATH_PLANNING=false       # 规划器是否产出可执行路径；false=顾问模式（只给场面分析/战术/combo）
PLANNER_RUSH_ANSWER=true          # ④升级竞速里规划器抢答；false=升级只跑单轮直答
ONESHOT_TIMEOUT_MS=5000           # one-shot 决策硬超时
CARD_RAG_PATH=data/card_rag/cards.jsonl   # 卡牌事实本地查表
LLM_REASONING_PLANNER=            # 规划器思考强度：off|low|medium|high；未配置=checkpoint 统一 low（推理档）、off=快档；抢答跟随 LLM_REASONING_DECISION
LLM_REASONING_DECISION=           # 决策器思考强度：off|low|medium|high；留空=默认 off（开了会吃决策超时）

# ---------- 全链路日志（排查用；默认关）----------
YGO_VERBOSE_LOG=false             # true=把 LLM 请求/响应原文、工具调用、决策流水、轨迹事件打到日志
YGO_VERBOSE_MAX_CHARS=0            # 单条内容最长打印多少字；0=不截断（全量）
YGO_LOG_DIR=                      # 日志目录；留空=自动定位到仓库根 logs/

# ---------- 连招库（PG combo_record，唯一 combo 存储）----------
COMBO_CONTEXT_LIMIT=10            # 己方主题注入规划器上下文的录入条数上限（1–30，创建时间倒序取最近）
COMBO_SUMMARY_MODEL=              # 录入摘要模型；留空=用 LLM_MODEL

# ---------- 赛后复盘（写进 LightRAG，供 search_duels 检索）----------
DUEL_SUMMARY_ENABLED=true         # false=完全不写
DUEL_SUMMARY_MODE=llm             # llm（默认，模型写复盘）| template（不调模型，只记事实）
DUEL_SUMMARY_MODEL=               # 留空=用 LLM_MODEL
DUEL_SUMMARY_TIMEOUT_MS=60000     # 单次复盘超时（旁路任务，可以给得比决策宽）
DUEL_SUMMARY_MAX_TOKENS=2000
DUEL_NARRATIVE_MAX_CHARS=8000     # 逐回合记录的字符预算（喂给模型的素材上限）
