<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志落盘配置。

  输出两路：
    1) 控制台（保持开发时 tail 的习惯，带颜色）；
    2) 文件 → ${LOG_DIR}/ygo-play-server.log，按 天 + 大小 滚动。

  LOG_DIR 由 LoggingPaths.configure() 在 main() 里算好并写进系统属性 ygo.log.dir：
  优先 YGO_LOG_DIR，其次从当前目录向上找仓库根，落到 <仓库根>/logs。
  这样无论从仓库根、模块目录还是 IDE 启动，日志都进同一个地方。

  全链路日志（YGO_VERBOSE_LOG=true）走的是 ygo.llm / ygo.decision 两个 logger，
  它们的 INFO 也会进同一个文件——所以单局复盘只需要看这一个文件。
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_DIR" value="${ygo.log.dir:-logs}"/>
    <property name="LOG_FILE" value="${LOG_DIR}/ygo-play-server.log"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 一天一个文件；单文件超过 100MB 就切（全链路日志一局可达数 MB） -->
            <fileNamePattern>${LOG_DIR}/archive/ygo-play-server.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全链路日志：显式钉在 INFO，避免将来把 root 调成 WARN 时把复盘素材一起丢掉 -->
    <logger name="ygo.llm" level="INFO"/>
    <logger name="ygo.decision" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
